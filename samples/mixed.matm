matrix MixedMatrix {
    types: [uint, double, string]
    ops: [+, *]
    subops: [
        [uint, double] + [uint, double] >> infer: default;
        [uint, double] * [uint, double] >> infer: default;

        // custom subop
        uint * string >> string: commute (num, text) {
            string result = "";
            for i inrange num:
                result += text;
            ret result;
        }
    ]
};

uint COLS = 3;
uint ROWS = 3;

MixedMatrix A, B, C;
init A enumerate;
init B 2.0;
init C "x";

apply A all >> infer:(old) {
    if old % 2 == 0:
        ret "even";
    ret old;
}

file out = stdout;
write out A;
write out A * C;
write out B + B;
write out vstack(A, C);
write out sum C;